      "html": "<div class=\"ds-tabs\" role=\"tablist\"><button class=\"ds-tab\" role=\"tab\"><span class=\"ds-bar\" style=\"background:#e2b33c\"></span>Title</button><button class=\"ds-tab ds-tab-on\" role=\"tab\" aria-selected=\"true\"><span class=\"ds-bar\" style=\"background:currentColor\"></span>Champions League places</button><button class=\"ds-tab\" role=\"tab\"><span class=\"ds-bar\" style=\"background:#b3362c\"></span>Relegation</button></div>",
