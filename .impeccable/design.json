  "narrative": {
    "northStar": "Stand Signage",
    "overview": "The table is signed like a British football ground. Signs are enamel plates: slate, rounded, with a thin white keyline set just inside the edge. Everything that names or marks something (the header, section headings, column headings, badges, Shifts, My team) is a plate; everything that is data (positions, points, Chances) sits on a cool white enamel ground in full ink. Zones are coloured the way a ground colours its stands: gold for the Title, enamel blue for Champions League places, signal red for Relegation.\n\nDensity is high on purpose. On a 390px phone the whole 20-row table (# · Team · GD · Pts · Title · CL · Rel) fits beneath the header, with Zone tabs on its left edge. Wide screens add P/W/D/L columns and put My team and the Matchweek in a sticky side panel, so a Lock and the Shifts it causes are seen together. The one authored motion is the signature: a Lock lights the rows that moved and drops their Shift plates in.\n\nThe system refuses the score-app default of a grey table with green and red text: colour lives on plates and Zone tabs, never on the numerals themselves.",
    "keyCharacteristics": [
      "Slate enamel plates with an inset white keyline for every sign; data stays off plates.",
      "Zone colours as sign colours: gold, enamel blue, signal red.",
      "Condensed block-letter capitals (Barlow Condensed) for signs; system sans with tabular numerals for data.",
      "Numerals always full ink.",
      "Moved rows sit on a pale lit band; My team is a selected plate row.",
      "Light and dark themes from the same tokens; in the dark the selected plate inverts to white enamel."
    ],
    "rules": [
      {
        "name": "The Full Ink Rule",
        "body": "Numerals are always ink (or on-sel in the My team row). Good and bad news is carried by a Shift plate beside the number, never by colouring the number.",
        "section": "colors"
      },
      {
        "name": "The Sign Colour Rule",
        "body": "Gold, blue and red mean Title, Champions League places and Relegation, everywhere: Zone tabs, the table's left-edge Zone marks, the legend, the Key fixtures tabs. Gold also marks a Scenario. No other meaning may borrow them.",
        "section": "colors"
      },
      {
        "name": "The Good News Rule",
        "body": "A Shift plate is green when the change is good for the team and red when it is bad; Relegation inverts the arrow's meaning.",
        "section": "colors"
      },
      {
        "name": "The Sign Letter Rule",
        "body": "Barlow Condensed appears only in uppercase on signs and headings. It is never used for numerals in data or for running text.",
        "section": "typography"
      },
      {
        "name": "The Tabular Rule",
        "body": "Every number that can sit in a column uses tabular figures.",
        "section": "typography"
      },
      {
        "name": "The Keyline Rule",
        "body": "Large plates (header, section headings, the How-this-works summary) carry the inset keyline. Small tags (column headings, badges, Shift plates) are plain fills; the keyline would not read at that size.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do sign with plates: slate, 8px, inset white keyline (2px plate, 3.5px on-plate).",
      "Do keep every numeral in full ink with tabular figures.",
      "Do use gold, blue and red only for Title, Champions League places and Relegation (and gold for a Scenario).",
      "Do colour a Shift by good or bad news for the team, not by arrow direction.",
      "Do put dark ink (#15202b) on gold in both themes.",
      "Do let a Lock light the moved rows and drop in their Shift plates; keep it the one authored motion and honour reduced motion."
    ],
    "donts": [
      "Don't colour numerals green or red; that is the score-app default this system refuses.",
      "Don't put data on plates, apart from selected things (the My team row, a chosen Lock).",
      "Don't set running text or data numerals in Barlow Condensed.",
      "Don't add shadows beyond the plate keyline and the sticky Scenario band.",
      "Don't give Zone colours any second meaning."
    ]
  }
}
